@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Sale',
                     typeNamePlural: 'Sales',
                     title: { type: #STANDARD,
                              value: 'ID' } },
       presentationVariant: [{ sortOrder: [{ by: 'ID',
                                             direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM }] }] }
annotate entity ZHEADER_c_GG with
{
  @UI.facet: [{ id: 'Sales',
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                label: 'Sales',
                position: 10 },

              { id: 'Items',
                purpose: #STANDARD,
                type: #LINEITEM_REFERENCE,
                label: 'Items Sales',
                position: 20,
                targetElement: '_items' } ]
  @UI.hidden: true
  SalesUUID;
  //    element_name;

  @UI: { lineItem: [{ position: 10,
                     importance: #HIGH },

                    { position: 10,
                      importance: #HIGH,
                      type: #FOR_ACTION,
                      dataAction: 'acceptSales',
                      label: 'Accept Sales' },

                    { position: 20,
                      importance: #HIGH,
                      type: #FOR_ACTION,
                      dataAction: 'rejectSales',
                      label: 'Reject Sales' },

                    { position: 30,
                      importance: #HIGH,
                      type: #FOR_ACTION,
                      dataAction: 'deductDiscount',
                      label: 'Discountii',
                      invocationGrouping: #CHANGE_SET }
                  ],

         selectionField: [{ position: 10 }],

         identification: [{ position: 10, label: 'Sales ID-2' },

                          { type: #FOR_ACTION,
                            dataAction: 'acceptSales',
                            label: 'Accept Sales',
                            position: 10 },

                          { type: #FOR_ACTION,
                            dataAction: 'rejectSales',
                            label: 'Reject Sales',
                            position: 20 },

                           { type: #FOR_ACTION,
                            dataAction: 'deductDiscount',
                            label: 'Discountoo',
                            position: 30 }
                         ]
      }
  Id;
  @UI: { lineItem: [{  position:  20, importance:  #HIGH}],
         selectionField: [{ position: 20 }],
         identification: [{ position: 20, label: 'Email-2' }]
    }
  Email;
  @UI: { lineItem: [{  position:  30, importance:  #HIGH}],
    identification: [{ position: 30 }]
    }
  FirstName;
  @UI: { lineItem: [{  position:  40, importance:  #HIGH}],
    identification: [{ position: 40 }]
    }
  LastName;
  @UI: { lineItem: [{  position:  50, importance:  #HIGH}],
    identification: [{ position: 50 }]
    }
  Country;
  @UI: { lineItem: [{  position:  60, importance:  #HIGH}],
    identification: [{ position: 60 }]
    }
  Creaton;
  @UI: { lineItem: [{  position:  70, importance:  #HIGH}],
    identification: [{ position: 70 }]
    }
  DeliveryDate;
   @UI: { lineItem: [{  position:  80, importance:  #HIGH}],
    identification: [{ position: 80 }]
    } 
  OrderStatus;

  @UI.hidden: true
  LocalCreatedBy;
  @UI.hidden: true
  LocalCreatedAt;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;

}